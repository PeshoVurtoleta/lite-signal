{
  "name": "@zakkster/lite-signal",
  "version": "1.9.0-preview.6",
  "description": "Zero-GC reactive graph. Monomorphic object pool, versioned push-pull propagation, 32-bit modular versioning. Built for hot paths and long-running processes.",
  "author": "Zahary Shinikchiev <shinikchiev@yahoo.com>",
  "license": "MIT",
  "type": "module",
  "main": "./Signal.js",
  "module": "./Signal.js",
  "types": "./Signal.d.ts",
  "exports": {
    ".": {
      "node": "./Signal.js",
      "import": "./Signal.js",
      "types": "./Signal.d.ts",
      "default": "./Signal.js"
    }
  },
  "files": [
    "Signal.js",
    "Signal.d.ts",
    "Watch.js",
    "README.md",
    "llms.txt",
    "LICENSE.txt",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test --test-reporter=spec",
    "test:gc": "node --expose-gc --test --test-reporter=spec",
    "test:coverage": "c8 node --test --test-reporter=spec",
    "test:harness": "node --test --test-reporter=spec harness/ProfilerTools/",
    "bench": "node --expose-gc bench/benchmark.mjs",
    "bench-reactive": "node --expose-gc bench/benchmarkReactive.mjs",
    "harness": "node harness/run.mjs",
    "harness:smoke": "node harness/run.mjs smoke",
    "harness:field": "node harness/run.mjs field",
    "harness:dispose": "node harness/run.mjs dispose",
    "harness:churn": "node harness/run.mjs churn",
    "harness:owner": "node harness/run.mjs owner",
    "harness:creation": "node harness/run.mjs creation",
    "harness:perf": "node harness/run.mjs perf",
    "harness:toe": "node harness/run.mjs toe",
    "harness:all": "node harness/run.mjs all",
    "profile:burst": "node --expose-gc harness/burst-dag.mjs ./Signal.js",
    "profile:pull": "node --expose-gc harness/pull-stress.mjs",
    "gate": "node harness/VersionMatrix/pre-publish.mjs",
    "verify": "npm test && npm run harness:smoke && npm run bench",
    "torture": "node bench/torture/run.mjs",
    "torture:semantic": "node bench/torture/run.mjs --group semantic",
    "torture:soak": "node bench/torture/run.mjs --group soak"
  },
  "keywords": [
    "signal",
    "signals",
    "reactive",
    "reactivity",
    "computed",
    "effect",
    "zero-gc",
    "zero-allocation",
    "object-pool",
    "fine-grained",
    "twitch-extension",
    "performance",
    "devtools",
    "introspection",
    "owner-tree"
  ],
  "homepage": "https://github.com/PeshoVurtoleta/lite-signal#readme",
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/zakkster/lite-signal.git"
  },
  "bugs": {
    "url": "https://github.com/PeshoVurtoleta/lite-signal/issues",
    "email": "shinikchiev@yahoo.com"
  },
  "engines": {
    "node": ">=18"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/PeshoVurtoleta"
  },
  "sideEffects": false,
  "devDependencies": {
    "@zakkster/lite-devtools": "^1.2.0",
    "@zakkster/lite-gc-profiler": "^1.15.0",
    "@zakkster/lite-profiler": "^1.1.0",
    "@zakkster/lite-profiler-signal": "^1.2.0",
    "@zakkster/lite-signal": "^1.3.0 || >=1.4.0-beta.0 || >=1.6.0-preview.0",
    "c8": "^11.0.0"
  },
  "overrides": {
    "@zakkster/lite-time": {
      "@zakkster/lite-signal": "$@zakkster/lite-signal"
    },
    "@zakkster/lite-devtools": {
      "@zakkster/lite-signal": "$@zakkster/lite-signal"
    }
  }
}
